# Enable Expires headers
<IfModule mod_expires.c>
  ExpiresActive On

  # Default expires (1 month for safety)
  ExpiresDefault "access plus 1 month"

  # HTML documents (dynamic / no-cache or short cache)
  ExpiresByType text/html "access plus 0 seconds"

  # Data feeds
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"

  # CSS / Javascript (under _next/static we will set headers directly, but default is 1 month)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Images and Media
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# Custom cache control headers for static hashed resources
<IfModule mod_headers.c>
  # Year-long immutable caching for Next.js generated chunks under _next/static/
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|ico|svg|webp|avif)$">
    <If "%{REQUEST_URI} =~ m#/_next/static/#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>

  # For non-hashed assets (images, uploads) setting sensible lifetime
  <FilesMatch "\.(png|jpg|jpeg|gif|ico|svg|webp|avif|ttf|otf|woff2?)$">
    <If "%{REQUEST_URI} !~ m#/_next/static/#">
      Header set Cache-Control "public, max-age=2592000, must-revalidate"
    </If>
  </FilesMatch>

  # Never cache HTML or sitemap files
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# Enable compression (gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/xhtml+xml application/rss+xml image/svg+xml
</IfModule>

# Legacy WordPress redirects handled at Apache/cPanel level
Redirect 301 /face-lift-2 /face-lift
Redirect 301 /fat-injection-2 /fat-injection
Redirect 301 /fat-injection-3 /fat-injection
Redirect 301 /chin-implant-2 /chin-implant
Redirect 301 /tummy-tuck-2 /tummy-tuck
Redirect 301 /buccal-fat-pad-removal-2 /buccal-fat-pad-removal
Redirect 301 /dimple-creation-surgery-2 /dimple-creation-surgery
Redirect 301 /double-eyelid-surgery-2 /double-eyelid-surgery
